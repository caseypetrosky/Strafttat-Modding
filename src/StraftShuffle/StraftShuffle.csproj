<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spawn re-dealing. Shared settings come from ../../Directory.Build.props.

       No Assembly-CSharp reference on purpose: everything game-specific goes
       through GameAccess via AccessTools, so a game update degrades to a logged
       warning and vanilla spawns rather than a plugin that won't load. -->

  <PropertyGroup>
    <AssemblyName>StraftShuffle</AssemblyName>
    <RootNamespace>StraftShuffle</RootNamespace>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <!-- Shared helpers, compiled into each plugin rather than referenced,
       so every plugin stays a single self-contained DLL. -->
  <ItemGroup>
    <Compile Include="../Shared/*.cs" />
  </ItemGroup>

  <!-- Packaging for distribution.

         dotnet build src/StraftShuffle -p:Package=true

       Produces dist/StraftShuffle-<version>.zip in Thunderstore layout, which is
       also what mod managers accept as a local import. The version in
       packaging/manifest.json must match <Version> above; the check below fails
       the build rather than shipping a zip whose manifest disagrees with the
       DLL inside it. -->
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Package)' == 'true'">
    <PropertyGroup>
      <StageDir>$(MSBuildProjectDirectory)/../../dist/stage</StageDir>
      <DistDir>$(MSBuildProjectDirectory)/../../dist</DistDir>
      <ZipPath>$(DistDir)/$(AssemblyName)-$(Version).zip</ZipPath>
    </PropertyGroup>

    <ReadLinesFromFile File="$(MSBuildProjectDirectory)/packaging/manifest.json">
      <Output TaskParameter="Lines" ItemName="ManifestLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <ManifestText>@(ManifestLines)</ManifestText>
    </PropertyGroup>
    <Error Condition="!$(ManifestText.Contains('&quot;version_number&quot;: &quot;$(Version)&quot;'))"
           Text="packaging/manifest.json version_number does not match &lt;Version&gt; ($(Version)). Update both before packaging." />

    <RemoveDir Directories="$(StageDir)" />
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/packaging/manifest.json;$(MSBuildProjectDirectory)/packaging/icon.png;$(MSBuildProjectDirectory)/packaging/README.md;$(MSBuildProjectDirectory)/packaging/CHANGELOG.md"
          DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../LICENSE"
          DestinationFiles="$(StageDir)/LICENSE" Condition="Exists('$(MSBuildProjectDirectory)/../../LICENSE')" />

    <Delete Files="$(ZipPath)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ZipPath)" />
    <RemoveDir Directories="$(StageDir)" />
    <Message Importance="high" Text="--> packaged $(ZipPath)" />
  </Target>

</Project>
