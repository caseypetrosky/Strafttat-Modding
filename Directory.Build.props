<Project>

  <!-- ============================================================
       Shared build settings for every plugin in src/.
       MSBuild imports this automatically for any project beneath it,
       so per-plugin .csproj files only declare what's unique to them.

       EDIT ONE THING: GameDir, below. Everything else follows from it.
       ============================================================ -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DebugType>portable</DebugType>
    <!-- Unity assemblies aren't strong-named the way NuGet expects. -->
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
    <!-- Plugins are loaded by BepInEx, never referenced by other projects. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Your STRAFTAT install. Steam > right-click STRAFTAT > Manage >
       Browse local files. Forward slashes work fine on Windows.
       Override without editing this file:  dotnet build -p:GameDir=... -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/STRAFTAT</GameDir>
    <ManagedDir>$(GameDir)/STRAFTAT_Data/Managed</ManagedDir>
  </PropertyGroup>

  <!-- Where the built DLL gets dropped so the game actually loads it.

       This is NOT always under GameDir. Mod managers keep their own BepInEx
       install and inject it at launch, so a build that copies into the Steam
       folder succeeds while the plugin never loads - and nothing anywhere
       reports an error. Gale is detected here; a manual BepInEx install in the
       game folder is the fallback.

       Override either part without editing this file:
         dotnet build src/Foo -p:GaleProfile=Modded
         dotnet build src/Foo -p:PluginsDir="D:/somewhere/BepInEx/plugins" -->
  <PropertyGroup>
    <GaleProfile Condition="'$(GaleProfile)' == ''">Default</GaleProfile>
    <GaleProfileDir Condition="'$(GaleProfileDir)' == ''">$(APPDATA)/com.kesomannen.gale/straftat/profiles/$(GaleProfile)</GaleProfileDir>

    <PluginsDir Condition="'$(PluginsDir)' == '' And Exists('$(GaleProfileDir)/BepInEx')">$(GaleProfileDir)/BepInEx/plugins</PluginsDir>
    <PluginsDir Condition="'$(PluginsDir)' == ''">$(GameDir)/BepInEx/plugins</PluginsDir>
  </PropertyGroup>

  <!-- BepInEx 5 + HarmonyX. Comes from nuget.bepinex.dev (see NuGet.config),
       not nuget.org. BepInEx.Core pulls HarmonyX in transitively. -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
  </ItemGroup>

  <!-- Unity assemblies every plugin needs. Private=false means "don't copy
       these to my output" — the game already has them. -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fast iteration loop: a successful build lands the DLL straight in
       BepInEx/plugins/<AssemblyName>/. Build, relaunch game, test. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(PluginsDir)')">
    <MakeDir Directories="$(PluginsDir)/$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)/$(AssemblyName)" />
    <Message Importance="high" Text="--> $(AssemblyName).dll copied to $(PluginsDir)/$(AssemblyName)" />
  </Target>

  <Target Name="WarnIfNoGameDir" AfterTargets="Build" Condition="!Exists('$(ManagedDir)')">
    <Warning Text="GameDir not found: $(ManagedDir) -- set GameDir in Directory.Build.props" />
  </Target>

</Project>
