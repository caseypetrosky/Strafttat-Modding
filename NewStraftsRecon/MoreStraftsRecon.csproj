<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MoreStraftsRecon</AssemblyName>
    <RootNamespace>MoreStraftsRecon</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- Unity DLLs aren't strong-named the way NuGet expects; this keeps the build quiet. -->
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- ============================================================
       EDIT THIS. Point it at your STRAFTAT install folder.
       Find it via Steam > right-click STRAFTAT > Manage > Browse local files.
       Use forward slashes or double backslashes.
       ============================================================ -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/STRAFTAT</GameDir>

    <ManagedDir>$(GameDir)/STRAFTAT_Data/Managed</ManagedDir>
    <PluginsDir>$(GameDir)/BepInEx/plugins</PluginsDir>
  </PropertyGroup>

  <!-- BepInEx 5 + HarmonyX come from the BepInEx NuGet feed (see NuGet.config) -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
  </ItemGroup>

  <!-- Game + Unity assemblies, referenced straight out of your install.
       Private=false means "don't copy these into my output" - the game already has them. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Uncomment once you confirm these exist in your Managed folder.
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FishNet.Runtime">
      <HintPath>$(ManagedDir)/FishNet.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    -->
  </ItemGroup>

  <!-- Fast iteration loop: every successful build lands the DLL in BepInEx/plugins.
       Build, alt-tab, relaunch game. That's the whole cycle. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(PluginsDir)')">
    <MakeDir Directories="$(PluginsDir)/MoreStraftsRecon" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)/MoreStraftsRecon" />
    <Message Importance="high" Text="--> Copied $(AssemblyName).dll to $(PluginsDir)/MoreStraftsRecon" />
  </Target>

  <Target Name="WarnIfNoGameDir" AfterTargets="Build" Condition="!Exists('$(ManagedDir)')">
    <Warning Text="GameDir not found: $(ManagedDir) -- edit GameDir in MoreStraftsRecon.csproj" />
  </Target>

</Project>
