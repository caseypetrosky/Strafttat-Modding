<Project Sdk="Microsoft.NET.Sdk">

  <!-- Exercises StraftatCap's cap arithmetic off the game. `dotnet run` here;
       exit code 0 means every check passed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>CapMathTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/StraftatCap/CapMath.cs" />
    <Compile Include="../../src/Shared/StaticAccess.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
